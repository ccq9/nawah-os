{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "records"
 ],
 "properties": {
  "schema_version": {
   "type": "string",
   "pattern": "^1\\.0\\.0$"
  },
  "records": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "question",
     "options",
     "recommendation",
     "impact",
     "blocked_task_ids",
     "requested_at",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Za-z0-9.-]+$"
     },
     "question": {
      "type": "string",
      "minLength": 1
     },
     "options": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "recommendation": {
      "type": "string",
      "minLength": 1
     },
     "impact": {
      "type": "string",
      "minLength": 1
     },
     "blocked_task_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[A-Z][A-Z0-9]*-[A-Za-z0-9.-]+$"
      },
      "uniqueItems": true
     },
     "requested_at": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "enum": [
       "open",
       "answered",
       "withdrawn"
      ]
     },
     "answer": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
