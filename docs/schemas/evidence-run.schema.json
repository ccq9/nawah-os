{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "run_id",
  "started_at",
  "finished_at",
  "source_revision",
  "dirty_state",
  "host",
  "target",
  "worker",
  "purpose",
  "commands",
  "exit_code"
 ],
 "properties": {
  "schema_version": {
   "type": "string",
   "pattern": "^1\\.(0|1)\\.0$"
  },
  "run_id": {
   "type": "string",
   "minLength": 1
  },
  "started_at": {
   "type": "string",
   "minLength": 1
  },
  "finished_at": {
   "type": "string",
   "minLength": 1
  },
  "source_revision": {
   "type": "string",
   "minLength": 1
  },
  "dirty_state": {
   "type": "boolean"
  },
  "host": {
   "type": "object"
  },
  "target": {
   "type": "string",
   "minLength": 1
  },
  "worker": {
   "type": "string",
   "enum": [
    "verification-runner",
    "interactive-agent",
    "test"
   ]
  },
  "purpose": {
   "type": "string",
   "minLength": 1
  },
  "commands": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "exit_code": {
   "type": "integer"
  },
  "notes": {
   "type": "string",
   "minLength": 1
  },
  "dirty_paths": {
   "type": "array",
   "maxItems": 50,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "ci": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "run_id",
    "run_attempt",
    "workflow",
    "event",
    "sha",
    "head_sha",
    "ref"
   ],
   "properties": {
    "run_id": {
     "type": "string"
    },
    "run_attempt": {
     "type": "integer",
     "minimum": 1
    },
    "workflow": {
     "type": "string"
    },
    "event": {
     "type": "string"
    },
    "sha": {
     "type": "string"
    },
    "head_sha": {
     "type": "string"
    },
    "ref": {
     "type": "string"
    }
   }
  }
 },
 "$comment": "evidence/<run>/run.json (ADR-0026). A verification-runner run carries its CI identity in ci; a 1.0.0 run has none.",
 "allOf": [
  {
   "if": {
    "properties": {
     "worker": {
      "const": "verification-runner"
     }
    },
    "required": [
     "worker"
    ]
   },
   "then": {
    "required": [
     "ci"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "schema_version": {
      "const": "1.0.0"
     }
    },
    "required": [
     "schema_version"
    ]
   },
   "then": {
    "not": {
     "required": [
      "ci"
     ]
    }
   }
  }
 ]
}
