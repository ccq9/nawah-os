{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "records"
 ],
 "properties": {
  "schema_version": {
   "type": "string",
   "pattern": "^1\\.0\\.0$"
  },
  "records": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "risk",
     "likelihood",
     "impact",
     "evidence",
     "owner",
     "warning_signal",
     "mitigation",
     "response_plan",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Za-z0-9.-]+$"
     },
     "risk": {
      "type": "string",
      "minLength": 1
     },
     "likelihood": {
      "enum": [
       "low",
       "medium",
       "high"
      ]
     },
     "impact": {
      "enum": [
       "low",
       "medium",
       "high",
       "critical"
      ]
     },
     "evidence": {
      "type": "string",
      "minLength": 1
     },
     "owner": {
      "type": "string",
      "minLength": 1
     },
     "warning_signal": {
      "type": "string",
      "minLength": 1
     },
     "mitigation": {
      "type": "string",
      "minLength": 1
     },
     "response_plan": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "enum": [
       "open",
       "mitigated",
       "accepted",
       "closed"
      ]
     }
    }
   }
  }
 }
}
