     "|exc|vector"
    ]
   },
   {
    "id": "TST-M2-VMM-SWITCH",
    "test_id": "TST-M2-VMM-SWITCH",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=vmm_switch"
    ],
    "oracle": "after the CR3 switch: CR3 = kernel PML4, CR0.WP and EFER.NXE set, .text RX / .data RW+NX / headers R+NX, direct map aliases RAM, null page and stack guard pages unmapped, boot-services memory reclaimed, allocator still works; exit 33",
    "expected_exit_code": 33,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=vmm_switch",
     "|ktest|pass|kernel address space active"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|",
     "|exc|vector"
    ]
   },
   {
    "id": "TST-M2-VMM-WP",
    "test_id": "TST-M2-VMM-WP",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=vmm_wp"
    ],
    "oracle": "supervisor write to .text with CR0.WP -> #PF error code 3 (present, write, supervisor: SDM Fig. 7-11); CR2 = RIP = target; exit 173",
    "expected_exit_code": 173,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=vmm_wp",
     "|exc|vector=14|name=#PF|error=0x3|"
    ],
    "forbidden_markers": [
