{
 "target": "pc-qemu",
 "purpose": "PC lab target: x86-64, UEFI (OVMF), QEMU q35, single vCPU. Single-image Rust kernel (kernel/, x86_64-unknown-uefi) per ADR-0001/ADR-0002.",
 "build": {
  "test_id": "TST-M1-BUILD",
  "timeout_s": 1200,
  "inputs": [
   "Cargo.toml",
   "kernel/Cargo.toml",
   "kernel/build.rs",
   ".cargo/config.toml",
   "rust-toolchain.toml",
   "platform/pc-qemu/target.json"
  ],
  "input_globs": [
   "kernel/src/**/*.rs"
  ],
  "artifact": "${OUT}/NAWAH.EFI",
  "extra_artifacts": [
   "${OUT}/NAWAH-NEG.EFI",
   "${OUT}/NAWAH-KTEST.EFI"
  ],
  "toolchain": "rust-1.97.0 x86_64-unknown-uefi",
  "steps": [
   [
    "cargo",
    "build",
    "--release",
    "--offline",
    "--manifest-path",
    "kernel/Cargo.toml",
    "--target",
    "x86_64-unknown-uefi",
    "--target-dir",
    "${OUT}/cargo"
   ],
   [
    "cp",
    "${OUT}/cargo/x86_64-unknown-uefi/release/nawah-kernel.efi",
    "${OUT}/NAWAH.EFI"
   ],
   [
    "cargo",
    "build",
    "--release",
    "--offline",
    "--manifest-path",
    "kernel/Cargo.toml",
    "--target",
    "x86_64-unknown-uefi",
    "--target-dir",
    "${OUT}/cargo-neg",
    "--features",
    "inject_ebs_fail"
   ],
   [
    "cp",
    "${OUT}/cargo-neg/x86_64-unknown-uefi/release/nawah-kernel.efi",
    "${OUT}/NAWAH-NEG.EFI"
   ],
   [
    "cargo",
    "build",
    "--profile",
    "ktest",
    "--offline",
    "--manifest-path",
    "kernel/Cargo.toml",
    "--target",
    "x86_64-unknown-uefi",
    "--target-dir",
    "${OUT}/cargo-ktest",
    "--features",
    "ktest"
   ],
   [
    "cp",
    "${OUT}/cargo-ktest/x86_64-unknown-uefi/ktest/nawah-kernel.efi",
    "${OUT}/NAWAH-KTEST.EFI"
   ]
  ]
 },
 "qemu": {
  "binary": "qemu-system-x86_64",
  "machine": "q35",
  "cpu": "qemu64",
  "memory": "512M",
  "smp": 1,
  "ovmf_code": "/usr/share/OVMF/OVMF_CODE_4M.fd",
  "ovmf_vars": "/usr/share/OVMF/OVMF_VARS_4M.fd",
  "boot_timeout_s": 180
 },
 "boot_oracle": {
  "test_id": "TST-M1-BOOT",
  "oracle": "contracts/boot.md v1: boot|start, boot|ebs|ok=1, then kernel|post_ebs with map_key and descriptors emitted from kernel/ after ExitBootServices; QEMU exit 33 (0x10 via isa-debug-exit); no boot|error",
  "expected_exit_code": 33,
  "required_markers": [
   "OSX|${BUILD_ID}|boot|start|arch=x86_64|boot=uefi|stage=pre_ebs",
   "OSX|${BUILD_ID}|boot|ebs|ok=1|attempts=",
   "OSX|${BUILD_ID}|kernel|cpu_tables|gdt=1|tss=1|idt=1|stack=kernel",
   "OSX|${BUILD_ID}|kernel|post_ebs|map_key=0x",
   "OSX|${BUILD_ID}|kernel|m1_done|exit=0x10"
  ],
  "forbidden_markers": [
   "|boot|error|",
   "|kernel|panic|"
  ],
  "max_counts": {
   "|boot|start|": 1
  }
 },
 "suites": {
  "M1": [
   {
    "id": "TST-M1-BOOT",
    "test_id": "TST-M1-BOOT",
    "oracle": "contracts/boot.md v1 success path (see boot_oracle); kernel-owned page tables active (vmm line: WP, NXE, section permissions, direct map), guarded stack adopted",
    "expected_exit_code": 33,
    "required_markers": [
     "OSX|${BUILD_ID}|boot|start|arch=x86_64|boot=uefi|stage=pre_ebs",
     "OSX|${BUILD_ID}|boot|ebs|ok=1|attempts=",
     "OSX|${BUILD_ID}|kernel|cpu_tables|gdt=1|tss=1|idt=1|stack=kernel",
     "|kernel|pmm|managed_frames=",
     "|selfcheck=1",
     "OSX|${BUILD_ID}|kernel|post_ebs|map_key=0x",
     "OSX|${BUILD_ID}|kernel|m1_done|exit=0x10",
     "|kernel|vmm|",
     "|wp=1|nxe=1|text_rx=1|data_rw_nx=1|",
     "|direct_ok=1",
     "|kernel|stack|guarded=1|"
    ],
    "forbidden_markers": [
     "|boot|error|",
     "|kernel|panic|"
    ],
    "max_counts": {
     "|boot|start|": 1
    }
   },
   {
    "id": "TST-M1-NEG",
    "test_id": "TST-M1-NEG",
    "artifact": "${OUT}/NAWAH-NEG.EFI",
    "oracle": "contracts/boot.md v1 failure path: stale map key injected -> firmware rejects EBS twice -> boot|error|code=BOOT_E_EBS_FAILED, boot|halt|reboot=0, QEMU exit 97 (0x30); exactly one boot|start (no reboot loop); kernel never entered",
    "expected_exit_code": 97,
    "required_markers": [
     "OSX|${BUILD_ID}|boot|start|",
     "OSX|${BUILD_ID}|boot|ebs|retry=1|",
     "OSX|${BUILD_ID}|boot|error|code=BOOT_E_EBS_FAILED|",
     "OSX|${BUILD_ID}|boot|halt|reboot=0"
    ],
    "forbidden_markers": [
     "|kernel|post_ebs|",
     "|boot|ebs|ok=1|"
    ],
    "max_counts": {
     "|boot|start|": 1
    }
   }
  ],
  "M2": [
   {
    "id": "TST-M2-EXC-DE",
    "test_id": "TST-M2-EXC-DE",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_de"
    ],
    "oracle": "SDM Table 7-1: #DE vector 0, no error code (fault: RIP at div); lab exit 145",
    "expected_exit_code": 145,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_de",
     "|exc|vector=0|name=#DE|error=0x0|",
     "|stack=kernel"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|"
    ],
    "equal_values": [
     [
      "expect_rip=(0x[0-9a-f]+)",
      "\\|rip=(0x[0-9a-f]+)\\|"
     ]
    ]
   },
   {
    "id": "TST-M2-EXC-UD",
    "test_id": "TST-M2-EXC-UD",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_ud"
    ],
    "oracle": "#UD vector 6, fault at ud2; exit 157",
    "expected_exit_code": 157,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_ud",
     "|exc|vector=6|name=#UD|error=0x0|"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|"
    ],
    "equal_values": [
     [
      "expect_rip=(0x[0-9a-f]+)",
      "\\|rip=(0x[0-9a-f]+)\\|"
     ]
    ]
   },
   {
    "id": "TST-M2-EXC-DB",
    "test_id": "TST-M2-EXC-DB",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_db"
    ],
    "oracle": "#DB single-step trap: saved RIP after the nop (SDM Event 1); exit 147",
    "expected_exit_code": 147,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_db",
     "|exc|vector=1|name=#DB|"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|"
    ],
    "equal_values": [
     [
      "expect_rip=(0x[0-9a-f]+)",
      "\\|rip=(0x[0-9a-f]+)\\|"
     ]
    ]
   },
   {
    "id": "TST-M2-EXC-GP",
    "test_id": "TST-M2-EXC-GP",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_gp"
    ],
    "oracle": "#GP on non-canonical address, error code 0 (SDM Event 13); exit 171",
    "expected_exit_code": 171,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_gp",
     "|exc|vector=13|name=#GP|error=0x0|"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|"
    ],
    "equal_values": [
     [
      "expect_rip=(0x[0-9a-f]+)",
      "\\|rip=(0x[0-9a-f]+)\\|"
     ]
    ]
   },
   {
    "id": "TST-M2-EXC-PF",
    "test_id": "TST-M2-EXC-PF",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_pf"
    ],
    "oracle": "#PF write to unmapped supervisor page: error code 2, CR2 = target (SDM Fig. 7-11); exit 173",
    "expected_exit_code": 173,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_pf",
     "|exc|vector=14|name=#PF|error=0x2|",
     "|cr2=0x600000001000|"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|"
    ],
    "equal_values": [
     [
      "expect_rip=(0x[0-9a-f]+)",
      "\\|rip=(0x[0-9a-f]+)\\|"
     ]
    ]
   },
   {
    "id": "TST-M2-EXC-BP",
    "test_id": "TST-M2-EXC-BP",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_bp"
    ],
    "oracle": "#BP is a trap: handler prints and returns; saved RIP after int3 (SDM Event 3)",
    "expected_exit_code": 33,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_bp",
     "|exc|vector=3|name=#BP|",
     "|ktest|pass|resumed after #BP"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|"
    ],
    "equal_values": [
     [
      "expect_rip=(0x[0-9a-f]+)",
      "\\|rip=(0x[0-9a-f]+)\\|"
     ]
    ]
   },
   {
    "id": "TST-M2-EXC-BP-STATE",
    "test_id": "TST-M2-EXC-BP-STATE",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_bp_state"
    ],
    "oracle": "iretq path restores 15 GPRs and CF/DF",
    "expected_exit_code": 33,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_bp_state",
     "|ktest|pass|registers and flags preserved"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|"
    ]
   },
   {
    "id": "TST-M2-EXC-DF",
    "test_id": "TST-M2-EXC-DF",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_df"
    ],
    "oracle": "corrupt RSP -> #PF undeliverable -> #DF (SDM Table 7-5) on IST1 stack, error code 0; exit 161",
    "expected_exit_code": 161,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_df",
     "|exc|vector=8|name=#DF|error=0x0|",
     "|stack=df"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|"
    ]
   },
   {
    "id": "TST-M2-EXC-NESTED",
    "test_id": "TST-M2-EXC-NESTED",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_nested"
    ],
    "oracle": "fault inside handler stops at nesting limit 3 with a fixed message; exit 157",
    "expected_exit_code": 157,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_nested",
     "|exc|nesting_limit|stopping"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|"
    ],
    "max_counts": {
     "|exc|vector=6|name=#UD|": 3
    },
    "min_counts": {
     "|exc|vector=6|name=#UD|": 3
    }
   },
   {
    "id": "TST-M2-IDT-LAYOUT",
    "test_id": "TST-M2-IDT-LAYOUT",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=idt_layout"
    ],
    "oracle": "sidt-walked IDT: 32 present gates push their own vector, dummy error code exactly per SDM Table 7-1, 224 empty gates",
    "expected_exit_code": 33,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=idt_layout",
     "|ktest|pass|idt layout"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|",
     "|idt_layout|vector="
    ]
   },
   {
    "id": "TST-M2-EXC-TRIPLE",
    "test_id": "TST-M2-EXC-TRIPLE",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=exc_triple"
    ],
    "oracle": "empty IDT + fault = triple fault -> QEMU reset -> exit 0 under -no-reboot; proves the runner detects a reset (no exception line printed)",
    "expected_exit_code": 0,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=exc_triple"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|",
     "|exc|vector"
    ]
   },
   {
    "id": "TST-M2-PMM-COUNTS",
    "test_id": "TST-M2-PMM-COUNTS",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=pmm_counts"
    ],
    "oracle": "1024 distinct, aligned, >=1 MiB, writable frames; counters move by N and return after free",
    "expected_exit_code": 33,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=pmm_counts",
     "|ktest|pass|pmm counters consistent"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|",
     "|exc|vector"
    ]
   },
   {
    "id": "TST-M2-PMM-EXHAUST",
    "test_id": "TST-M2-PMM-EXHAUST",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=pmm_exhaust"
    ],
    "oracle": "alloc until None: count == free_frames, free_frames==0 after, no panic",
    "expected_exit_code": 33,
    "required_markers": [
     "OSX|${BUILD_ID}|ktest|start|name=pmm_exhaust",
     "|ktest|pass|exhaustion returns None"
    ],
    "forbidden_markers": [
     "|ktest|fail|",
     "|kernel|panic|",
     "|exc|vector"
    ]
   },
   {
    "id": "TST-M2-PMM-DOUBLE-FREE",
    "test_id": "TST-M2-PMM-DOUBLE-FREE",
    "artifact": "${OUT}/NAWAH-KTEST.EFI",
    "qemu_extra": [
     "-fw_cfg",
     "name=opt/nawah/test,string=pmm_double_free"
    ],
    "oracle": "free twice -> NotAllocated; <1MiB, misaligned, bitmap storage -> Unmanaged",
    "expected_exit_code": 33,
    "required_markers": [
