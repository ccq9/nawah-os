{
  "target": "pc-qemu",
  "purpose": "PC lab target: x86-64, UEFI (OVMF), QEMU q35, single vCPU. Single-image Rust kernel (kernel/, x86_64-unknown-uefi) per ADR-0001/ADR-0002.",
  "build": {
    "test_id": "TST-M1-BUILD",
    "timeout_s": 1200,
    "inputs": [
      "Cargo.toml",
      "kernel/Cargo.toml",
      "kernel/build.rs",
      ".cargo/config.toml",
      "rust-toolchain.toml",
      "platform/pc-qemu/target.json"
    ],
    "input_globs": [
      "kernel/src/**/*.rs"
    ],
    "artifact": "${OUT}/NAWAH.EFI",
    "extra_artifacts": [
      "${OUT}/NAWAH-NEG.EFI",
      "${OUT}/NAWAH-KTEST.EFI"
    ],
    "toolchain": "rust-1.97.0 x86_64-unknown-uefi",
    "steps": [
      [
        "cargo",
        "build",
        "--release",
        "--offline",
        "--manifest-path",
        "kernel/Cargo.toml",
        "--target",
        "x86_64-unknown-uefi",
        "--target-dir",
        "${OUT}/cargo"
      ],
      [
        "cp",
        "${OUT}/cargo/x86_64-unknown-uefi/release/nawah-kernel.efi",
        "${OUT}/NAWAH.EFI"
      ],
      [
        "cargo",
        "build",
        "--release",
        "--offline",
        "--manifest-path",
        "kernel/Cargo.toml",
        "--target",
        "x86_64-unknown-uefi",
        "--target-dir",
        "${OUT}/cargo-neg",
        "--features",
        "inject_ebs_fail"
      ],
      [
        "cp",
        "${OUT}/cargo-neg/x86_64-unknown-uefi/release/nawah-kernel.efi",
        "${OUT}/NAWAH-NEG.EFI"
      ],
      [
        "cargo",
        "build",
        "--profile",
        "ktest",
        "--offline",
        "--manifest-path",
        "kernel/Cargo.toml",
        "--target",
        "x86_64-unknown-uefi",
        "--target-dir",
        "${OUT}/cargo-ktest",
        "--features",
        "ktest"
      ],
      [
        "cp",
        "${OUT}/cargo-ktest/x86_64-unknown-uefi/ktest/nawah-kernel.efi",
        "${OUT}/NAWAH-KTEST.EFI"
      ]
    ]
  },
  "qemu": {
    "binary": "qemu-system-x86_64",
    "machine": "q35",
    "cpu": "qemu64",
    "memory": "512M",
    "smp": 1,
    "ovmf_code": "/usr/share/OVMF/OVMF_CODE_4M.fd",
    "ovmf_vars": "/usr/share/OVMF/OVMF_VARS_4M.fd",
    "boot_timeout_s": 180
  },
  "boot_oracle": {
    "test_id": "TST-M1-BOOT",
    "oracle": "contracts/boot.md v1: boot|start, boot|ebs|ok=1, then kernel|post_ebs with map_key and descriptors emitted from kernel/ after ExitBootServices; QEMU exit 33 (0x10 via isa-debug-exit); no boot|error",
    "expected_exit_code": 33,
    "required_markers": [
      "OSX|${BUILD_ID}|boot|start|arch=x86_64|boot=uefi|stage=pre_ebs",
      "OSX|${BUILD_ID}|boot|ebs|ok=1|attempts=",
      "OSX|${BUILD_ID}|kernel|cpu_tables|gdt=1|tss=1|idt=1|stack=kernel",
      "OSX|${BUILD_ID}|kernel|post_ebs|map_key=0x",
      "OSX|${BUILD_ID}|kernel|m1_done|exit=0x10"
    ],
    "forbidden_markers": [
      "|boot|error|",
      "|kernel|panic|"
    ],
    "max_counts": {
      "|boot|start|": 1
    }
  },
  "suites": {
    "M1": [
      {
        "id": "TST-M1-BOOT",
        "test_id": "TST-M1-BOOT",
        "oracle": "contracts/boot.md v1 success path (see boot_oracle); kernel-owned page tables active (vmm line: WP, NXE, section permissions, direct map), guarded stack adopted; scheduler self-check (kernel thread spawned and joined, no frame left) and ring-3 ping as process 1; object self-check (VMO through a kernel channel, peer close seen, nothing left)",
        "expected_exit_code": 33,
        "required_markers": [
          "OSX|${BUILD_ID}|boot|start|arch=x86_64|boot=uefi|stage=pre_ebs",
          "OSX|${BUILD_ID}|boot|ebs|ok=1|attempts=",
          "OSX|${BUILD_ID}|kernel|cpu_tables|gdt=1|tss=1|idt=1|stack=kernel",
          "|kernel|pmm|managed_frames=",
          "|selfcheck=1",
          "OSX|${BUILD_ID}|kernel|post_ebs|map_key=0x",
          "OSX|${BUILD_ID}|kernel|m1_done|exit=0x10",
          "|kernel|vmm|",
          "|wp=1|nxe=1|text_rx=1|data_rw_nx=1|",
          "|direct_ok=1",
          "|kernel|stack|guarded=1|",
          "OSX|${BUILD_ID}|boot|acpi|rsdp=0x",
          "|kernel|irq|pic_masks=0xff,0xff|",
          "|kernel|timer|window_ms=50|pit_ok=1|",
          "|max_depth=1|selfcheck=1",
          "|cpus=1|ioapics=1|ioapic_entries=24|ioapic_masked=24|",
          "|kernel|mm|heap_ok=1|scratch_ok=1|as_ok=1|as_code=ok|",
          "|frames_delta=0|selfcheck=1",
          "|kernel|sched|boot_tid=0|probe_join=0x5eee|",
          "|threads=1|processes=0|quantum_ticks=10|frames_delta=0|code=ok|selfcheck=1",
          "|kernel|object|channel_ok=1|vmo_size=8192|peer_closed=1|live_channels=0|live_endpoints=0|live_vmos=0|live_handles=0|frames_delta=0|selfcheck=1",
          "|kernel|user|lstar=0x",
          "|pid=1|ping_exit=0x1235|frames_delta=0|code=ok|selfcheck=1"
        ],
        "forbidden_markers": [
          "|boot|acpi|rsdp=0x0|",
          "|boot|error|",
          "|exc|vector",
          "|kernel|panic|"
        ],
        "max_counts": {
          "|boot|start|": 1
        }
      },
      {
        "id": "TST-M1-NEG",
        "test_id": "TST-M1-NEG",
        "artifact": "${OUT}/NAWAH-NEG.EFI",
        "oracle": "contracts/boot.md v1 failure path: stale map key injected -> firmware rejects EBS twice -> boot|error|code=BOOT_E_EBS_FAILED, boot|halt|reboot=0, QEMU exit 97 (0x30); exactly one boot|start (no reboot loop); kernel never entered",
        "expected_exit_code": 97,
        "required_markers": [
          "OSX|${BUILD_ID}|boot|start|",
          "OSX|${BUILD_ID}|boot|ebs|retry=1|",
          "OSX|${BUILD_ID}|boot|error|code=BOOT_E_EBS_FAILED|",
          "OSX|${BUILD_ID}|boot|halt|reboot=0"
        ],
        "forbidden_markers": [
          "|kernel|post_ebs|",
          "|boot|ebs|ok=1|"
        ],
        "max_counts": {
          "|boot|start|": 1
        }
      }
    ],
    "M2": [
      {
        "id": "TST-M2-EXC-DE",
        "test_id": "TST-M2-EXC-DE",
        "artifact": "${OUT}/NAWAH-KTEST.EFI",
        "qemu_extra": [
          "-fw_cfg",
          "name=opt/nawah/test,string=exc_de"
        ],
        "oracle": "SDM Table 7-1: #DE vector 0, no error code (fault: RIP at div); lab exit 145",
        "expected_exit_code": 145,
        "required_markers": [
          "OSX|${BUILD_ID}|ktest|start|name=exc_de",
          "|exc|vector=0|name=#DE|error=0x0|",
          "|stack=kernel"
        ],
        "forbidden_markers": [
          "|ktest|fail|",
          "|kernel|panic|"
        ],
        "equal_values": [
          [
            "expect_rip=(0x[0-9a-f]+)",
            "\\|rip=(0x[0-9a-f]+)\\|"
          ]
        ]
      },
      {
        "id": "TST-M2-EXC-UD",
        "test_id": "TST-M2-EXC-UD",
        "artifact": "${OUT}/NAWAH-KTEST.EFI",
        "qemu_extra": [
